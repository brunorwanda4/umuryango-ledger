# Umuryango Ledger - Environment Configuration Example

# Server Configuration
PORT=4433
HOST=0.0.0.0
RUST_LOG=info,actix_web=info,umuryango=debug

# PostgreSQL Database Configuration (SQLx)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/umuryango_ledger
DATABASE_MAX_CONNECTIONS=20

# MinIO / S3 Object Storage (receipt attachments & localized PDF/CSV exports)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=umuryango-receipts
S3_REGION=us-east-1

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min32chars
JWT_EXPIRATION_HOURS=72

# Default Locale (en = English, rw = Kinyarwanda)
DEFAULT_LOCALE=rw

# Web App Configuration
NEXT_PUBLIC_API_URL=http://localhost:4433/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4433/api/v1/ws
NEXT_PUBLIC_DEFAULT_LOCALE=rw
